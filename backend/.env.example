DATABASE_URL="postgresql://fintra:fintra@localhost:5432/fintra?schema=public"

REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="30d"

# 9router / OpenRouter — used server-side only for receipt scanning (Fase 5).
# OPENROUTER_BASE_URL is the OpenAI-compatible chat-completions base URL to
# call (no trailing slash) — point it at your 9router endpoint. Leave empty
# to call OpenRouter directly at https://openrouter.ai/api/v1.
OPENROUTER_BASE_URL=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"

NODE_ENV="development"
PORT=3000

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN="http://localhost:5173"

# Optional — leave empty to disable error tracking
SENTRY_DSN=""

# Article feature — shared secret for POST /api/articles/internal, the
# endpoint a daily Claude Code Routine calls (after researching real,
# currently-viral IDN personal-finance content via web search) to submit
# the finished article. No human is logged in when the Routine fires, so
# this endpoint is authenticated with a static key instead of a user JWT.
# Leave empty to keep the endpoint disabled (always rejected).
INTERNAL_API_KEY=""
